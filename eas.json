{
    "cli":  {
                "appVersionSource":  "remote"
            },
    "build":  {
                  "vantara":  {
                                  "distribution":  "internal",
                                  "channel":  "vantara",
                                  "android":  {
                                                  "buildType":  "apk"
                                              },
                                  "env":  {
                                              "EXPO_PUBLIC_APP_MODE":  "VANTARA",
                                              "EXPO_PUBLIC_RORK_API_BASE_URL":  "https://mythos-nexus-api.vantaramavis.workers.dev"
                                          }
                              },
                  "navi":  {
                               "distribution":  "internal",
                               "channel":  "navi",
                               "android":  {
                                               "buildType":  "apk"
                                           },
                               "env":  {
                                           "EXPO_PUBLIC_APP_MODE":  "NAVI",
                                           "EXPO_PUBLIC_RORK_API_BASE_URL":  "https://mythos-navi-api.vantaramavis.workers.dev"
                                       }
                           },
                  "development":  {
                                      "developmentClient":  true,
                                      "distribution":  "internal",
                                      "channel":  "vantara",
                                      "android":  {
                                                      "buildType":  "apk"
                                                  },
                                      "env":  {
                                                  "EXPO_PUBLIC_APP_MODE":  "VANTARA",
                                                  "EXPO_PUBLIC_RORK_API_BASE_URL":  "https://mythos-nexus-api.vantaramavis.workers.dev"
                                              }
                                  }
              }
}
